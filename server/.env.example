# Dailymotion API configuration
# Add your Dailymotion API credentials here when required by Dailymotion.
# The public video search endpoint works without credentials for public videos,
# but protected endpoints require an API key / secret.

DAILYMOTION_API_BASE=https://api.dailymotion.com

# DAILYMOTION_API_KEY=your_api_key
# DAILYMOTION_API_SECRET=your_api_secret

PORT=5000
